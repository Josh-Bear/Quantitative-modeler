# ── MongoDB ───────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017
# Docker:     mongodb://db:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=bl_optimizer

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# :8770 = legacy vanilla-JS app (server.py) and docker-compose's React frontend
# :5173 = React frontend via `npm run dev` (not through Docker)
CORS_ORIGINS=http://localhost:8770,http://localhost:5173
